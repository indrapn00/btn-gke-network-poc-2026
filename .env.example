# ==============================================================================
# .env.example
# Optional Environment Overrides for BTN GKE Island-Mode Network PoC
#
# By default, `scripts/00-env.sh` automatically detects your active GCP project,
# region, and zone from `gcloud config`.
# If you want to customize any values for a specific customer environment, copy
# this file to `.env` (`cp .env.example .env`) and edit the values below.
# ==============================================================================

# 1. Target GCP Environment (Leave commented out to auto-detect from `gcloud config`)
# PROJECT_ID="your-gcp-project-id"
# REGION="asia-southeast2"
# ZONE="asia-southeast2-a"

# 2. VPC & Subnet Names
# GCP_VPC="btn-gcp-vpc"
# GKE_SUBNET="btn-gke-subnet"
# PRIVATE_NAT_SUBNET="btn-private-nat-subnet"
# PROXY_ONLY_SUBNET="btn-proxy-only-subnet"
# ALICLOUD_VPC="sim-alicloud-vpc"
# ALICLOUD_SUBNET="sim-alicloud-subnet"

# 3. IP Addressing Plan
# GKE_NODE_CIDR="10.2.2.0/24"
# GKE_POD_RANGE_NAME="gke-pods"
# GKE_POD_CIDR="10.2.16.0/23"
# GKE_SVC_RANGE_NAME="gke-services"
# GKE_SVC_CIDR="10.2.18.0/23"
# PROXY_ONLY_CIDR="10.2.20.0/23"
# PRIVATE_NAT_CIDR="10.2.99.96/29"
# PRIVATE_NAT_SNAT_IP="10.2.99.99"
# ILB_VIP_ADDRESS="10.2.2.200"
# ALICLOUD_SUBNET_CIDR="192.168.1.0/24"
# ALICLOUD_VM_IP="192.168.1.10"

# 4. BGP ASNs & GKE Cluster Name
# GCP_ASN="65001"
# ALICLOUD_ASN="65002"
# GKE_CLUSTER="btn-gke-island-cluster"
